# Optional; default publisher selection uses the curated Germany catalog.
GEMINI_API_KEY=
SUGGESTION_DISCOVERY=curated
PORT=3001
NODE_ENV=production
MOCKUP_CONCURRENCY=1
MOCKUP_JOB_TIMEOUT_MS=70000
CAPTURE_VIEWPORT_WIDTH=1366
CAPTURE_MAX_HEIGHT=3400
CAPTURE_MAX_SCROLL_PX=1600
SLOT_SCAN_LIMIT=900
CURATED_SLOT_PROBE_CONCURRENCY=1
SUGGESTION_PREFLIGHT_TIMEOUT_MS=4500
SUGGESTION_PREFLIGHT_CONCURRENCY=4
# Server-managed directories; browser downloads use the browser's own folder.
ADFRAME_DATA_DIR=
ADFRAME_OUTPUT_DIR=
