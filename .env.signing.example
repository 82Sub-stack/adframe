# Copy to .env.signing and fill in values locally. Do not commit .env.signing.

# macOS code signing. Use either CSC_LINK/CSC_KEY_PASSWORD or install the
# Developer ID Application certificate in your login keychain.
# CSC_LINK=/absolute/path/to/developer-id-application.p12
# CSC_KEY_PASSWORD=certificate-export-password
# CSC_NAME=Developer ID Application: Company Name (TEAMID)

# Preferred notarization credentials: App Store Connect API key.
# APPLE_API_KEY=/absolute/path/to/AuthKey_KEYID.p8
# APPLE_API_KEY_ID=KEYID
# APPLE_API_ISSUER=ISSUER_UUID

# Alternative notarization credentials: Apple ID app-specific password.
# APPLE_ID=developer@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID

# Alternative notarization credentials: notarytool keychain profile.
# APPLE_KEYCHAIN_PROFILE=adframe-notary
# APPLE_KEYCHAIN=/Users/you/Library/Keychains/login.keychain-db
